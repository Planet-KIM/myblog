# Core
SECRET_KEY=replace_with_long_random_secret

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2

# Newsletter
# local/dev: false (화면 fallback 링크)
# production: true + SMTP 설정 필수
NEWSLETTER_ENABLE_SEND=false
NEWSLETTER_FROM_EMAIL=no-reply@example.com
NEWSLETTER_FROM_NAME=Planet KIM's Travel
NEWSLETTER_SMTP_HOST=smtp.example.com
NEWSLETTER_SMTP_PORT=587
NEWSLETTER_SMTP_USERNAME=mailer@example.com
NEWSLETTER_SMTP_PASSWORD=replace_with_app_password
NEWSLETTER_SMTP_USE_TLS=true
NEWSLETTER_SMTP_USE_SSL=false
NEWSLETTER_SMTP_TIMEOUT_SECONDS=10
NEWSLETTER_VERIFY_TOKEN_TTL_HOURS=24
NEWSLETTER_UNSUBSCRIBE_TOKEN_TTL_HOURS=720
